
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#F5F7F5">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Smart Pantry Manager"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#194B38"
        android:layout_marginBottom="12dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Reduce food waste. Cook with what you have."
        android:textSize="16sp"
        android:textColor="#555555"
        android:layout_marginBottom="30dp" />

    <Button
        android:id="@+id/btnPantry"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="My Pantry" />

    <Button
        android:id="@+id/btnRecipes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Suggested Recipes" />

    <Button
        android:id="@+id/btnSettings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Settings" />

</LinearLayout>
